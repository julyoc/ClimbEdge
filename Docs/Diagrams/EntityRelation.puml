@startuml ClimbEdge.Docs.Diagrams.EntityRelation

entity "BaseEntity" as BaseEntity {
    +Id: long
    +Uid: Guid
    +Slug: string <<unique>>
    +Metadata: jsonb
    +RowVersion: byte[]
    +CreatedAt: DateTime
    +UpdatedAt: DateTime?
    +DeletedAt: DateTime?
    +RestoredAt: DateTime?
    +LockedAt: DateTime?
}
package "Auditing" {
    enum "AuditActionType" as AuditActionType {
        +Create
        'Create: Registro creado
        +Update
        'Update: Registro actualizado
        +Delete
        'Delete: Registro eliminado
        +Restore
        'Restore: Registro restaurado
        +Lock
        'Lock: Registro bloqueado
        +Unlock
        'Unlock: Registro desbloqueado
        +Login
        'Login: Inicio de sesión
        +Logout
        'Logout: Cierre de sesión
        +View
        'View: Registro visualizado
        +Download
        'Download: Archivo descargado
        +Export
        'Export: Datos exportados
        +Import
        'Import: Datos importados
    }
    enum "AuditRiskLevel" as AuditRiskLevel {
        +Low
        'Low: Riesgo bajo, cambios menores o rutinarios.
        +Medium
        'Medium: Riesgo moderado, cambios que pueden afectar la integridad de los datos.
        +High
        'High: Riesgo alto, cambios significativos que pueden comprometer la seguridad.
        +Critical
        'Critical: Riesgo crítico, cambios que pueden causar fallos graves en el sistema.
    }
    enum "ResultStatus" as ResultStatus {
        +Success
        'Success: La operación se completó con éxito.
        +Failed
        'Failed: La operación falló.
        +Partial
        'Partial: La operación se completó parcialmente.
    }
    entity "AuditTrail" as AuditTrail {
        'Registro de auditoría granular para trazabilidad completa del sistema.
        'Captura todos los cambios realizados en las entidades principales del sistema.
        ..inherits BaseEntity..
        +EntityName: string
        ' Nombre de la entidad afectada (ej: "Board", "User", "ClimbRoute")
        +EntityId: long
        ' ID del registro afectado
        +AuditActionType: AuditActionType
        +UserId: long?
        ' Usuario que realizó la acción (null para acciones del sistema)
        +SessionId: string?
        ' ID de sesión para rastrear actividades relacionadas
        +IpAddress: string?
        ' Dirección IP desde donde se realizó la acción
        +UserAgent: string?
        ' Información del navegador/aplicación
        +OldValues: jsonb?
        ' Valores anteriores del registro (para Updates)
        +NewValues: jsonb?
        ' Nuevos valores del registro (para Creates/Updates)
        +ChangesSummary: string?
        ' Resumen legible de los cambios realizados
        +ReasonForChange: string?
        ' Razón del cambio (opcional, para cambios administrativos)
        +AffectedColumns: string[]?
        ' Lista de columnas que fueron modificadas
        +CorrelationId: string?
        ' ID para correlacionar múltiples cambios relacionados
        +RiskLevel: AuditRiskLevel?
        ' Nivel de riesgo: "Low", "Medium", "High", "Critical"
        +IsSystemAction: bool
        ' Indica si la acción fue realizada por el sistema automáticamente
        +Duration: int?
        ' Duración de la operación en milisegundos
        +ResultStatus: ResultStatus?
        ' Estado del resultado: "Success", "Failed", "Partial"
        +ErrorMessage: string?
        ' Mensaje de error si la operación falló
        +AdditionalContext: jsonb?
        ' Contexto adicional específico de la operación
    }
}
enum "ConfigurationKey" as ConfigurationKey {
    System_Language
    System_MaintenanceMode

    User_DefaultBoard
    User_ShowTips

    Training_DefaultDifficultyScaleName
    Training_DefaultDifficultyRange
    Training_ShowBetaVideos
    Training_AutoLoadSession

    Notification_EmailEnabled
    Notification_PushEnabled
    Notification_QuietHoursStart
    Notification_QuietHoursEnd


    Units_Length
    Units_Weight
    Units_Temperature
}
entity "Configuration" as Configuration {
    'Configuración del sistema, que almacena configuraciones globales y personalizadas.
    'Representa una configuración específica del sistema, como preferencias de usuario, configuraciones de aplicación
    ..inherits BaseEntity..
    +Key: ConfigurationKey
    +UserId: long
    ' unique(UserId, Key)
    +Value: string
    +Description: string?
    +IsSensitive: bool
}
entity "UserProfile" as UserProfile {
    ..inherits BaseEntity..
    +UserId: long <<unique>>
    +FirstName: string?
    +LastName: string?
    +DateOfBirth: DateOnly?
    +Bio: string?
    +ProfilePictureUrl: string?
    +Website: string?
    +Location: string?
    +Country: string
    +TimeZone: string
    +PreferredLanguage: string
    +IsPublic: bool
    +EmailNotifications: bool
    +PushNotifications: bool
    +ClimbingExperienceLevel: string?
    +PreferredClimbingStyle: string?
    +EmergencyContact: string?
    +EmergencyContactName: string?
}
entity "AppUser" as AppUser {
    ..inherits BaseEntity..
    +Username: string? <<unique>>
    +NormalizedUserName: string? <<unique>>
    +Email: string? <<unique>>
    +NormalizedEmail: string? <<unique>>
    +EmailConfirmed: bool
    +PasswordHash: string?
    +SecurityStamp: string?
    +ConcurrencyStamp: string?
    +PhoneNumber: string?
    +PhoneNumberConfirmed: bool
    +TwoFactorEnabled: bool
    +LockoutEnd: DateTime?
    +LockoutEnabled: bool
    +AccessFailedCount: int
}
entity "AppRole" as AppRole {
    +Id: long
    +Name: string? <<unique>>
    +NormalizedName: string? <<unique>>
    +ConcurrencyStamp: string?
}
'
'
' Estoy hasta aqui con las entidades db config y repositories
'
'
package "Boards" {
    enum "BoardVisibility" as BoardVisibility {
        +Public
        'Public: El tablero es visible para todos los usuarios.
        +Private
        'Private: El tablero es visible solo para los miembros del tablero.
        +Protected
        'Protected: El tablero es visible para los miembros del tablero y aquellos con el enlace directo.
        +Hidden
        'Hidden: El tablero no es visible en la lista de tableros, pero accesible mediante enlace directo.
        +Archived
        'Archived: El tablero está archivado y no es visible, pero se puede restaurar.
    }
    enum "BoardMemberRole" as BoardMemberRole {
        +Owner 
        'Owner: Propietario del tablero, tiene todos los permisos.
        +Admin
        'Admin: Administrador del tablero, puede gestionar miembros y configuraciones.
        +Member
        'Member: Miembro del tablero, puede ver y participar en el tablero.
        +Viewer
        'Viewer: Solo puede ver el tablero, sin permisos de edición.
    }
    entity "Board" as Board {
        'Tablero de escalada, que puede contener problemas, configuraciones y miembros.
        'Representa un espacio de trabajo para organizar y gestionar problemas de escalada.
        'Por ejemplo un moon board, un muro de escalada o una zona de escalada.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Visibility: BoardVisibility
        +BoardConfigId: long
        ' Configuración del tablero, que define las propiedades y características del tablero.
        +OrganizationId: long?
        ' Organización propietaria del tablero (opcional para tableros privados)
    }
    entity "BoardMember" as BoardMember {
        'Miembro del tablero, que puede tener diferentes roles y permisos.
        'Representa a un usuario que forma parte de un tablero de escalada.
        ..inherits BaseEntity..
        +BoardId: long
        +UserId: long
        +IsPropertyOwner: bool
        +Role: BoardMemberRole
    }
    entity "BoardConfig" as BoardConfig {
        'Configuración del tablero, que define las propiedades y características del tablero.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Version: string
        ' Versión de la configuración (ej: "1.0", "2.1", "3.0-beta")
        +IsActive: bool
        ' Indica si esta versión está actualmente activa
        +PreviousVersionId: long?
        ' Referencia a la versión anterior para historial
        +Content: string
        +Columns: int
        +Rows: int
        +Width: int
        +Height: int
        +InterItemSpacingVertical: int
        +InterItemSpacingHorizontal: int
        ' Espacio entre elementos del tablero, que define la separación media entre las presas.
        +IsStaggeredGrid: bool
        ' StaggeredGrid: Indica si el tablero utiliza un diseño de cuadrícula escalonada.
        '   true: El tablero utiliza un diseño de cuadrícula escalonada.
        '   false: El tablero utiliza un diseño de cuadrícula regular.
        +StaggeredGridOffset: int
        ' StaggeredGridOffset: Desplazamiento de la cuadrícula escalonada
        +Difficulty: int
        +CreatedByUserId: long
        ' Usuario que creó esta versión de configuración
        +ApprovedByUserId: long?
        ' Usuario que aprobó esta versión (para control de calidad)
        +ApprovedAt: DateTime?
        +ChangeNotes: string?
        ' Notas sobre los cambios realizados en esta versión
        +IsBackwardCompatible: bool
        ' Indica si esta versión es compatible con versiones anteriores
        +MigrationScript: string?
        ' Script o instrucciones para migrar desde versiones anteriores
    }
    enum "AngleUnit" as AngleUnit {
        +Degrees
        ' Degrees: Grados, la unidad más común para medir ángulos.
        +Radians
        ' Radians: Radianes, una unidad alternativa de medida de ángulos.
    }
    entity "BoardAngle" as BoardAngle {
        'Ángulo de inclinación del tablero, que define la inclinación del tablero de escalada.
        'Representa un ángulo específico de inclinación del tablero, como vertical, 20 grados, etc.
        'El rango del ángulo puede variar según el tipo de tablero. Normal de 10 a 65 grados.
        'Cada ángulo puede tener diferentes propiedades y características.
        'Los angulos se establecen de 5 en 5 grados, por ejemplo: 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65.
        ..inherits BaseEntity..
        +Angle: int <<unique>>
        +Unit: AngleUnit = AngleUnit.Degrees
        ' Unidad del ángulo, por ejemplo, grados, radianes, etc.
        +Description: string?
    }
    entity "BoardItemType" as BoardItemType {
        'Tipo de elemento del tablero, que define las características y propiedades de un elemento (presa).
        'Representa un tipo de presa o elemento que se puede usar en un tablero de escalada.
        'Por ejemplo: canto, regleta, etc.
        'Cada tipo de elemento puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Difficulty: int
        +Icon: string?
    }
    entity "BoardItemTextureMaterial" as BoardItemTextureMaterial {
        'Material de textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa un material o textura que se puede aplicar a un elemento del tablero de escalada.
        'Por ejemplo, madera, resina, goma, etc.
        'Cada material de textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItemTexture" as BoardItemTexture {
        'Textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa una textura específica que se puede aplicar a un elemento del tablero de escalada
        'Por ejemplo, liso, rugoso, áspero, etc.
        'Cada textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItemVolume" as BoardItemVolume {
        'Volumen o forma tridimensional del elemento del tablero.
        'Representa la forma 3D, el tamaño y las dimensiones físicas de una presa.
        'Por ejemplo: micro, crimps, jugs, slopers, etc.
        'Cada volumen puede tener diferentes propiedades y características físicas.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +VolumeType: string
        +Width: decimal?
        ' Ancho físico en centímetros
        +Height: decimal?
        ' Alto físico en centímetros
        +Depth: decimal?
        ' Profundidad física en centímetros
        +GridWidth: int
        ' Ancho en número de celdas de la cuadrícula (1, 2, 3, etc.)
        +GridHeight: int
        ' Alto en número de celdas de la cuadrícula (1, 2, 3, etc.)
        +ModelUrl: string?
        ' URL del modelo 3D del volumen
        +ThumbnailUrl: string?
        +ImageUrl: string?
        +Difficulty: int
        +Properties: jsonb
        ' Propiedades específicas como ángulo de agarre, superficie, etc.
    }
    enum "HoldOrientation" as HoldOrientation {
        +Normal
        +Undercling
        +Sidepull
        +Pinch
        +Sloper
    }
    enum "HoldUsage" as HoldUsage {
        +Both
        'Both: Se puede usar como pie y mano
        +HandOnly
        'HandOnly: Solo se puede usar como mano
        +FootOnly
        'FootOnly: Solo se puede usar como pie
    }
    entity "BoardItem" as BoardItem {
        'Elemento del tablero, que representa una presa o elemento específico en un tablero de escalada.
        'Cada elemento puede tener diferentes propiedades y características, como posición, tipo, textura, etc
        ..inherits BaseEntity..
        +BoardConfigId: long
        +PositionX: int
        +PositionY: int
        'unique(BoardConfigId, PositionX, PositionY)
        +Orientation: HoldOrientation = HoldOrientation.Normal
        +AllowedUsage: HoldUsage = HoldUsage.Both
        +Difficulty: int
        +BoardItemTypeId: long
        +BoardItemVolumeId: long?
        ' Volumen base de la presa (opcional para compatibilidad)
    }
    entity "BoardItemTextureCombination" as BoardItemTextureCombination {
        'Combinación de texturas aplicadas a un elemento del tablero.
        'Permite que una presa tenga múltiples texturas aplicadas simultáneamente.
        ..inherits BaseEntity..
        +BoardItemId: long
        +BoardItemTextureId: long
        +BoardItemTextureMaterialId: long?
        +Percentage: decimal?
        ' Porcentaje de cobertura de esta textura en la presa (0-100)
        +Order: int
        ' Orden de aplicación de las texturas (para efectos visuales)
        +IsActive: bool
        ' Permite activar/desactivar texturas específicas
    }
}
package "Boards.Problems" {
    entity "BoardProblemAngle" as BoardProblemAngle {
        'Ángulo del problema del tablero, que define la inclinación del problema de escalada.
        +BoardProblemId: long
        +BoardAngleId: long
        'unique(BoardProblemId, BoardAngleId)
        +DifficultyScaleId: long
        +Rating: float?
    }
    entity "BoardProblemTag" {
        +Id: long
        +Name: string
        +Description: string?
    }
    entity "BoardProblem" as BoardProblem {
        'Problema del tablero, que representa un conjunto de elementos (presas) organizados en un tablero de escalada.
        ..inherits BaseEntity..
        +BoardConfigId: long
        +Name: string <<unique>>
        +Description: string?
        +IsPublic: bool
        +CreatedByUserId: long? <<index>>
        +GeneratedByAI: bool = false
        ' Indica si el problema fue generado por IA.
    }
    entity "BoardProblemItem" as BoardProblemItem {
        'Elemento del problema del tablero, que representa una presa específica en un problema de escalada.
        ..inherits BaseEntity..
        +Sequence: int?
        +BoardProblemId: long
        +BoardItemId: long
        +BoardProblemItemTypeId: long
    }
    entity "BoardProblemItemType" as BoardProblemItemType {
        'Tipo de elemento del problema del tablero, que define las características y propiedades de un elemento (presa) en un problema de escalada.
        ..inherits BaseEntity..
        +ColorRed: short
        +ColorGreen: short
        +ColorBlue: short
        +ColorName: string?
        +ColorCode: int
        +IsFoot: bool
        ' Foot: Presa que se usa como pie.
        +IsHand: bool
        ' Hand: Presa que se usa como mano.
        +IsStart: bool
        ' Start: Presa(s) que se usa como inicio del problema.
        +IsEnd: bool
        ' End: Presa(s) que se usa como final del problema.
        +IsZone: bool
        ' Zone: Presa que se puede designar como zona de descanso, pero no es obligatoria.
        +IsMandatory: bool
        'Mandatory: Presa que debe usarse, aunque el orden no importa.
        +IsTouchOnly: bool
        'TouchOnly: Solo se toca, no se debe mantener
        +Difficulty: int
        ' Dificultad del elemento, que debe ser un valor numérico.
    }
    entity "FootRule" as FootRule {
        ..inherits BaseEntity..
        'Regla de uso de pies en el problema de escalada.
        +Name: string
        +Code: string
        +Description: string
    }
}
package "DifficultyScales" {
    entity "DifficultyScaleType" as DifficultyScaleType {
        'Tipo de escalada, por ejemplo, deportiva, boulder, trad, etc.
        'Define el tipo de escala de dificultad que se utilizará.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Icon: string?
    }
    entity "DifficultyScaleName" as DifficultyScaleName {
        'Nombre de la escala de dificultad, por ejemplo, VScale, French, etc.
        'Asocia un nombre de escala de dificultad con un tipo de escala.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +DifficultyScaleTypeId: long
    }
    entity "DifficultyScale" as DifficultyScale {
        'Escala de dificultad, por ejemplo, V1, 5.10a, etc.
        'Asocia un nombre de escala de dificultad con un grupo de dificultad.
        'Representa una escala de dificultad específica dentro de un tipo y nombre de escala.
        ..inherits BaseEntity..
        +DifficultyScaleNameId: long
        +DifficultyGroupId: long
        +Value: string
        +IRCRA: int
        +Version: string
        ' Versión de la escala (ej: "2024.1", "2025.0")
        +IsActive: bool
        ' Indica si esta versión de la escala está activa
        +PreviousVersionId: long?
        ' Referencia a la versión anterior de la escala
        +EffectiveDate: DateTime
        ' Fecha desde la cual esta versión es efectiva
        +ExpiryDate: DateTime?
        ' Fecha hasta la cual esta versión es válida
        +ConversionTable: jsonb?
        ' Tabla de conversión desde versiones anteriores
        +ChangeReason: string?
        ' Razón del cambio de versión
        +ApprovedByOrganization: string?
        ' Organización que aprobó esta versión (ej: IFSC, UIAA)
    }
    entity "DifficultyGroup" as DifficultyGroup {
        'Grupo de dificultad, por ejemplo, principiante, intermedio, avanzado, elite, etc.
        'Agrupa escalas de dificultad bajo un mismo grupo.
        ..inherits BaseEntity..
        +Level: int
        +Name: string
        +Description: string?
        +IsFemale: bool
        ' IsFemale: Indica si el grupo de dificultad es específico para escaladoras mujeres.
    }
}
package "Mountains" {
    enum "MountainType" as MountainType {
        +Peak
        'Peak: Pico o cumbre montañosa.
        +Ridge
        'Ridge: Cordillera o cresta.
        +Volcano
        'Volcano: Volcán.
        +Hill
        'Hill: Colina.
        +Plateau
        'Plateau: Meseta.
        +Canyon
        'Canyon: Cañón.
        +Valley
        'Valley: Valle.
    }
    enum "RouteType" as RouteType {
        +Hiking
        'Hiking: Senderismo.
        +Mountaineering
        'Mountaineering: Montañismo.
        +RockClimbing
        'RockClimbing: Escalada en roca.
        +IceClimbing
        'IceClimbing: Escalada en hielo.
        +MixedClimbing
        'MixedClimbing: Escalada mixta.
        +Skiing
        'Skiing: Esquí.
        +Snowboarding
        'Snowboarding: Snowboard.
        +Via_Ferrata
        'Via_Ferrata: Vía ferrata.
    }
    enum "SeasonType" as SeasonType {
        +Spring
        'Spring: Primavera.
        +Summer
        'Summer: Verano.
        +Autumn
        'Autumn: Otoño.
        +Winter
        'Winter: Invierno.
        +YearRound
        'YearRound: Todo el año.
    }
    entity "Mountain" as Mountain {
        'Montaña o formación geológica específica.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Type: MountainType
        +Elevation: int
        ' Elevación en metros sobre el nivel del mar.
        +Location: geography(POINT,4326)
        ' Coordenadas geográficas usando PostGIS (latitud, longitud).
        +Country: string
        +Region: string?
        +Province: string?
        +FirstAscentDate: DateTime?
        +FirstAscentBy: string?
        ' Nombre de quien realizó la primera ascensión.
        +IsActive: bool
        ' Indica si la montaña está disponible para actividades.
        +DangerLevel: int
        ' Nivel de peligro del 1 al 5.
        +ImageUrl: string?
        +WeatherStationId: string?
        ' ID de estación meteorológica cercana.
    }
    entity "MountainRoute" as MountainRoute {
        'Ruta específica en una montaña.
        ..inherits BaseEntity..
        +MountainId: long
        +Name: string
        +Description: string?
        +Type: RouteType
        +DifficultyScaleId: long
        +Distance: decimal
        ' Distancia total de la ruta en kilómetros.
        +ElevationGain: int
        ' Ganancia de elevación en metros.
        +EstimatedDuration: int
        ' Duración estimada en minutos.
        +BestSeason: SeasonType
        +RequiresPermit: bool
        +MaxGroupSize: int?
        +IsGuided: bool
        ' Indica si requiere guía obligatorio.
        +DangerLevel: int
        ' Nivel de peligro específico de la ruta.
        +FirstAscentDate: DateTime?
        +FirstAscentBy: string?
    }
    entity "WaypointType" as WaypointType {
        'Tipo de punto de referencia en una ruta.
        'Define los tipos de puntos de referencia que pueden existir a lo largo de una ruta.
        'Por ejemplo: inicio, descanso, campamento, cumbre, peligro, foto, fin, emergencia.
        ' Tipo: "Start", "Break", "Lunch", "Camp", "Summit", "Danger", "Photo", "End", "Emergency".
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Icon: string?
    }
    entity "RouteWaypoint" as RouteWaypoint {
        'Puntos de referencia a lo largo de una ruta.
        ..inherits BaseEntity..
        +MountainRouteId: long
        +Name: string
        +Description: string?
        +Location: geography(POINT,4326)
        ' Coordenadas del waypoint usando PostGIS.
        +Elevation: int
        ' Elevación del punto en metros.
        +Sequence: int
        ' Orden en la secuencia de la ruta.
        +WaypointTypeId: long
        +EstimatedTimeFromPrevious: int?
        ' Tiempo estimado desde el waypoint anterior en minutos.
        +Notes: string?
        +ImageUrl: string?
    }
    entity "RouteTrack" as RouteTrack {
        'Track GPS completo de la ruta.
        ..inherits BaseEntity..
        +MountainRouteId: long
        +Name: string?
        +TrackData: geography(LINESTRING,4326)
        ' Línea GPS completa usando PostGIS.
        +TotalDistance: decimal
        ' Distancia total calculada del track.
        +MinElevation: int
        +MaxElevation: int
        +RecordedBy: string?
        ' Quien registró el track.
        +RecordedDate: DateTime?
        +GpsDevice: string?
        ' Dispositivo GPS utilizado.
        +Accuracy: decimal?
        ' Precisión del GPS en metros.
    }
    entity "MountainFile" as MountainFile {
        'Archivos asociados a montañas (fotos, mapas, documentos).
        ..inherits BaseEntity..
        +MountainId: long
        +FileType: string
        ' Tipo: "Photo", "Map", "Topo", "Document", "Video", "3DModel".
        +FileName: string
        +FileSize: int
        +FileUrl: string
        +ThumbnailUrl: string?
        +Title: string?
        +Description: string?
        +TakenAt: DateTime?
        ' Fecha en que se tomó la foto/video.
        +TakenBy: string?
        ' Quien tomó la foto/video.
        +Location: geography(POINT,4326)?
        ' Ubicación donde se tomó la foto.
        +Elevation: int?
        +IsPublic: bool
    }
    entity "RouteFile" as RouteFile {
        'Archivos específicos de rutas (croquis, fotos, GPX).
        ..inherits BaseEntity..
        +MountainRouteId: long
        +FileType: string
        ' Tipo: "Topo", "Photo", "GPX", "KML", "Croquis", "Document".
        +FileName: string
        +FileSize: int
        +FileUrl: string
        +ThumbnailUrl: string?
        +Title: string?
        +Description: string?
