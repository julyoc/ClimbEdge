package "Versioning" {
    enum "ConfigurationType" as ConfigurationType {
        +BoardConfig
        'BoardConfig: Configuración de tablero
        +TrainingPlan
        'TrainingPlan: Plan de entrenamiento
        +DifficultyScale
        'DifficultyScale: Escala de dificultad
        +Organization
        'Organization: Configuración de organización
        +System
        'System: Configuración del sistema
        +UserPreferences
        'UserPreferences: Preferencias de usuario
    }
    enum "VersionStatus" as VersionStatus {
        +Draft
        'Draft: Borrador, en desarrollo
        +Testing
        'Testing: En pruebas
        +Active
        'Active: Versión activa en producción
        +Deprecated
        'Deprecated: Versión obsoleta pero aún funcional
        +Archived
        'Archived: Versión archivada, no funcional
        +Rollback
        'Rollback: Versión de rollback temporal
    }
    entity "ConfigurationVersion" as ConfigurationVersion {
        'Historial de versiones para diferentes tipos de configuraciones del sistema.
        'Permite mantener un control granular de cambios en configuraciones críticas.
        ..inherits BaseEntity..
        +ConfigurationType: ConfigurationType
        +EntityId: long
        ' ID de la entidad específica que está siendo versionada
        +Version: string
        ' Número de versión semántica (ej: "1.0.0", "2.1.3-beta")
        +MajorVersion: int
        +MinorVersion: int
        +PatchVersion: int
        +PreReleaseTag: string?
        ' Tag de pre-release (ej: "alpha", "beta", "rc1")
        +Status: VersionStatus
        +PreviousVersionId: long?
        ' Referencia a la versión anterior
        +ConfigurationData: jsonb
        ' Snapshot completo de la configuración en esta versión
        +ChangesSummary: string
        ' Resumen de cambios realizados en esta versión
        +BreakingChanges: string[]?
        ' Lista de cambios que rompen compatibilidad
        +MigrationInstructions: string?
        ' Instrucciones para migrar desde versiones anteriores
        +CreatedByUserId: long
        +ApprovedByUserId: long?
        +ApprovedAt: DateTime?
        +ActivatedAt: DateTime?
        ' Fecha en que esta versión se activó
        +DeactivatedAt: DateTime?
        ' Fecha en que esta versión se desactivó
        +IsBackwardCompatible: bool
        +IsForwardCompatible: bool
        +MinimumRequiredVersion: string?
        ' Versión mínima requerida para upgrade
        +TestResults: jsonb?
        ' Resultados de pruebas de esta versión
        +PerformanceMetrics: jsonb?
        ' Métricas de rendimiento de esta versión
        +RollbackInstructions: string?
        ' Instrucciones para hacer rollback
        +ExpiryDate: DateTime?
        ' Fecha de expiración para versiones temporales
    }
    entity "VersionDependency" as VersionDependency {
        'Dependencias entre diferentes versiones de configuraciones.
        'Permite definir relaciones y dependencias entre versiones.
        ..inherits BaseEntity..
        +ParentVersionId: long
        ' Versión que tiene la dependencia
        +DependentVersionId: long
        ' Versión de la cual depende
        +DependencyType: string
        ' Tipo: "Required", "Optional", "Incompatible", "Recommended"
        +MinVersion: string?
        ' Versión mínima requerida
        +MaxVersion: string?
        ' Versión máxima compatible
        +Description: string?
        ' Descripción de la dependencia
    }
}

