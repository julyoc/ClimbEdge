package "Boards" {
    enum "BoardVisibility" as BoardVisibility {
        +Public
        'Public: El tablero es visible para todos los usuarios.
        +Private
        'Private: El tablero es visible solo para los miembros del tablero.
        +Protected
        'Protected: El tablero es visible para los miembros del tablero y aquellos con el enlace directo.
        +Hidden
        'Hidden: El tablero no es visible en la lista de tableros, pero accesible mediante enlace directo.
        +Archived
        'Archived: El tablero está archivado y no es visible, pero se puede restaurar.
    }
    enum "BoardMemberRole" as BoardMemberRole {
        +Owner 
        'Owner: Propietario del tablero, tiene todos los permisos.
        +Admin
        'Admin: Administrador del tablero, puede gestionar miembros y configuraciones.
        +Member
        'Member: Miembro del tablero, puede ver y participar en el tablero.
        +Viewer
        'Viewer: Solo puede ver el tablero, sin permisos de edición.
    }
    entity "Board" as Board {
        'Tablero de escalada, que puede contener problemas, configuraciones y miembros.
        'Representa un espacio de trabajo para organizar y gestionar problemas de escalada.
        'Por ejemplo un moon board, un muro de escalada o una zona de escalada.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Visibility: BoardVisibility
    }
    entity "BoardMember" as BoardMember {
        'Miembro del tablero, que puede tener diferentes roles y permisos.
        'Representa a un usuario que forma parte de un tablero de escalada.
        ..inherits BaseEntity..
        +BoardId: long
        +UserId: long
        +IsPropertyOwner: bool
        +Role: BoardMemberRole
    }
    entity "BoardConfig" as BoardConfig {
        'Configuración del tablero, que define las propiedades y características del tablero.
        ..inherits BaseEntity..
        +BoardId: long
        +Content: string
        +Columns: int
        +Rows: int
        +Width: int
        +Height: int
        +Inclination_grades: int
        +Difficulty: int
    }
    entity "BoardItemType" as BoardItemType {
        'Tipo de elemento del tablero, que define las características y propiedades de un elemento (presa).
        'Representa un tipo de presa o elemento que se puede usar en un tablero de escalada.
        'Por ejemplo: canto, regleta, etc.
        'Cada tipo de elemento puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Difficulty: int
        +Icon: string?
    }
    entity "BoardItemTextureMaterial" as BoardItemTextureMaterial {
        'Material de textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa un material o textura que se puede aplicar a un elemento del tablero de escalada.
        'Por ejemplo, madera, resina, goma, etc.
        'Cada material de textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItemTexture" as BoardItemTexture {
        'Textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa una textura específica que se puede aplicar a un elemento del tablero de escalada
        'Por ejemplo, liso, rugoso, áspero, etc.
        'Cada textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItem" as BoardItem {
        'Elemento del tablero, que representa una presa o elemento específico en un tablero de escalada.
        'Cada elemento puede tener diferentes propiedades y características, como posición, tipo, textura, etc
        ..inherits BaseEntity..
        +BoardConfigId: long <<unique>>
        +PositionX: int <<unique>>
        +PositionY: int <<unique>>
        +Difficulty: int
        +BoardItemTypeId: long
        +BoardItemTextureId: long?
        +BoardItemTextureMaterialId: long?
    }
}
