package "Mountains.Itinerary" {
    enum MountaineerTickType {
        'Summit: Cima alcanzada exitosamente.
        Summit
        'Attempted: Intentado, pero no se alcanzó la cumbre (retirada por clima, fatiga, etc.).
        Attempted
        'Planned: Ascenso planificado, aún no intentado.
        Planned
        'Abandoned: Expedición abandonada antes o durante el intento.
        Abandoned
        'Failed: Intento fallido por causas externas o físicas (no cima, no éxito, más grave).
        Failed
        'Rescue: Se necesitó rescate o evacuación.
        Rescue
        'Repeat: Cima ya alcanzada previamente, ruta repetida.
        Repeat
    }
}
package "Climbing" {
    entity "ClimbZone" as ClimbZone {
        'Zona de escalada, que representa una ubicación geográfica específica para escalar.
        'Representa una zona de escalada, que puede contener múltiples rutas de escalada.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Location: Point?
        +IsPublic: bool
        +IsIndoor: bool
        +ImageUrl: string?
    }
    entity "ClimbRoute" as ClimbRoute {
        'PitchCount se refiere al número de tramos o largos de la ruta.
        'FirstAscentDate se refiere a la fecha de la primera ascensión de la ruta
        ..inherits BaseEntity..
        +Name: string
        +Description: string
        +DifficultyScaleId: long
        +DifficultyScaleNameId: long
        +ClimbTagId: long?
        +PitchCount: int?
        +FirstAscentDate: DateTime?
    }
    entity "ClimbTag" as ClimbTag {
        'Etiqueta de escalada, que se utiliza para clasificar y organizar rutas de escalada.
        'Representa una etiqueta o categoría que se puede asignar a una ruta de escalada
        'Por ejemplo, Placa, Tech, Crack, etc.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
    }
    entity "rock_features" as RockFeatures {
        'Características de la roca, que se utilizan para describir las características geológicas de una ruta de escalada.
        'Representa características geológicas específicas de una ruta de escalada, como tipo de roca, textura, etc.
        ..inherits BaseEntity..
        +Description: string?
        +ClimbRouteId: long
        +RockType: string?
    }
    entity "ClimbRouteDescription" as ClimbRouteDescription {
        'Descripción de la ruta de escalada, que proporciona información detallada sobre la ruta.
        'Representa una descripción detallada de una ruta de escalada, incluyendo características, historia, etc.
        ..inherits BaseEntity..
        +ClimbRouteId: long
        +Content: string
    }
    entity "ClimbRouteFile" as ClimbRouteFile {
        'Imagen de la ruta de escalada, que se utiliza para mostrar imágenes relacionadas con la ruta.
        'Representa una imagen asociada a una ruta de escalada, como fotos de la ruta, croquis, etc.
        'sketch se refiere a un croquis o dibujo de la ruta de escalada.
        ..inherits BaseEntity..
        +ClimbRouteId: long
        +IsSketch: bool
        +FileName: string
        +FileType: string
        +FileSize: int
        +FileUrl: string
        +FileResourceUrl: string[]?
        +ThumbnailUrl: string?
        +Description: string?
    }
    entity "ClimbZoneFile" as ClimbZoneFile {
        'Imagen de la zona de escalada, que se utiliza para mostrar imágenes relacionadas con la zona.
        'Representa una imagen asociada a una zona de escalada, como fotos de la zona, croquis, etc.
        'sketch se refiere a un croquis o dibujo de la zona de escalada.
        ..inherits BaseEntity..
        +ClimbZoneId: long
        +IsSketch: bool
        +FileName: string
        +FileType: string
        +FileSize: int
        +FileUrl: string
        +FileResourceUrl: string[]?
        +ThumbnailUrl: string?
        +Description: string?
    }
}
package "Sessions" {
    entity "UserSession" as UserSession {
        'Sesión del usuario en escalada, que representa una sesión de escalada específica.
        'Representa una sesión de escalada del usuario, incluyendo el usuario, la ruta de escalada
        'y la duración de la sesión.
        ..inherits BaseEntity..
        +UserId: long
        +BoardId: long?
        +ClimbZoneId: long?
        +BeginAt: DateTime
        +EndAt: DateTime?
        +Duration: int
        +Notes: string?
    }
    entity "UserSessionProgress" as UserSessionProgress {
        'Progreso del usuario en una ruta de escalada, que rastrea el progreso del usuario en una ruta específica.
        'Representa el progreso del usuario en una ruta de escalada, incluyendo intentos y completados
        'y la sesión de usuario asociada.
        'Tick se refiere al modo en que se completa la ruta
        ..inherits BaseEntity..
        +ClimbRouteId: long
        +ClimbTickType: ClimbTickType
        +IsCompleted: bool
        +Duration: int?
        +TryAt: DateTime?
        +UserSessionId: long
    }
    enum ClimbTickType {
        'Onsight: Primera vez que se intenta la ruta, sin información previa ni caídas.
        Onsight
        'Flash: Primera vez que se intenta la ruta, pero con información previa (beta).
        Flash
        'Redpoint: Ruta encadenada tras varios intentos anteriores.
        Redpoint
        'Repeat: Ruta que ya fue encadenada antes, repetida nuevamente.
        Repeat
        'Project: Ruta que está en proceso, aún no ha sido encadenada.
        Project
        'Attempt: Intento en la ruta, sin haber llegado al encadenamiento.
        Attempt
        'Toprope: Ruta encadenada o intentada en top rope (no líder). [no aplica en boulder]
        Toprope
        'Dogged: Ruta encadenada con descansos (colgado de la cuerda). [no aplica en boulder]
        Dogged
        'Fell: El usuario se cayó intentando la ruta.
        Fell
        'Abandoned: El usuario decidió no continuar intentando la ruta.
        Abandoned
    }
}
