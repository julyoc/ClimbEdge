@startuml ClimbEdge.Docs.Diagrams.EntityRelation

entity "BaseEntity" as BaseEntity {
    +Id: long
    +Uid: Guid
    +Slug: string <<unique>>
    +Metadata: jsonb
    +RowVersion: byte[]
    +CreatedAt: DateTime
    +UpdatedAt: DateTime?
    +DeletedAt: DateTime?
    +RestoredAt: DateTime?
    +LockedAt: DateTime?
}
entity "Configuration" as Configuration {
    'Configuración del sistema, que almacena configuraciones globales y personalizadas.
    'Representa una configuración específica del sistema, como preferencias de usuario, configuraciones de aplicación
    ..inherits BaseEntity..
    +Key: string <<unique>>
    +Value: string
    +Description: string?
    +IsSensitive: bool
    +UserId: long
}
entity "UserProfile" as UserProfile {
    ..inherits BaseEntity..
    +UserId: long
    +FirstName: string?
    +LastName: string?
    +DateOfBirth: DateOnly?
    +Bio: string?
    +ProfilePictureUrl: string?
    +Website: string?
    +Location: string?
    +Country: string
    +TimeZone: string
    +PreferredLanguage: string
    +IsPublic: bool
    +EmailNotifications: bool
    +PushNotifications: bool
    +ClimbingExperienceLevel: string?
    +PreferredClimbingStyle: string?
    +EmergencyContact: string?
    +EmergencyContactName: string?
}
entity "AppUser" as AppUser {
    ..inherits BaseEntity..
    +Username: string?
    +NormalizedUserName: string?
    +Email: string?
    +NormalizedEmail: string?
    +EmailConfirmed: bool
    +PasswordHash: string?
    +SecurityStamp: string?
    +ConcurrencyStamp: string?
    +PhoneNumber: string?
    +PhoneNumberConfirmed: bool
    +TwoFactorEnabled: bool
    +LockoutEnd: DateTime?
    +LockoutEnabled: bool
    +AccessFailedCount: int
}
entity "AppRole" as AppRole {
    +Id: long
    +Name: string?
    +NormalizedName: string?
    +ConcurrencyStamp: string?
}
package "Boards" {
    enum "BoardVisibility" as BoardVisibility {
        +Public
        'Public: El tablero es visible para todos los usuarios.
        +Private
        'Private: El tablero es visible solo para los miembros del tablero.
        +Protected
        'Protected: El tablero es visible para los miembros del tablero y aquellos con el enlace directo.
        +Hidden
        'Hidden: El tablero no es visible en la lista de tableros, pero accesible mediante enlace directo.
        +Archived
        'Archived: El tablero está archivado y no es visible, pero se puede restaurar.
    }
    enum "BoardMemberRole" as BoardMemberRole {
        +Owner 
        'Owner: Propietario del tablero, tiene todos los permisos.
        +Admin
        'Admin: Administrador del tablero, puede gestionar miembros y configuraciones.
        +Member
        'Member: Miembro del tablero, puede ver y participar en el tablero.
        +Viewer
        'Viewer: Solo puede ver el tablero, sin permisos de edición.
    }
    entity "Board" as Board {
        'Tablero de escalada, que puede contener problemas, configuraciones y miembros.
        'Representa un espacio de trabajo para organizar y gestionar problemas de escalada.
        'Por ejemplo un moon board, un muro de escalada o una zona de escalada.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Visibility: BoardVisibility
    }
    entity "BoardMember" as BoardMember {
        'Miembro del tablero, que puede tener diferentes roles y permisos.
        'Representa a un usuario que forma parte de un tablero de escalada.
        ..inherits BaseEntity..
        +BoardId: long
        +UserId: long
        +IsPropertyOwner: bool
        +Role: BoardMemberRole
    }
    entity "BoardConfig" as BoardConfig {
        'Configuración del tablero, que define las propiedades y características del tablero.
        ..inherits BaseEntity..
        +BoardId: long
        +Content: string
        +Columns: int
        +Rows: int
        +Width: int
        +Height: int
        +Inclination_grades: int
        +Difficulty: int
    }
    entity "BoardItemType" as BoardItemType {
        'Tipo de elemento del tablero, que define las características y propiedades de un elemento (presa).
        'Representa un tipo de presa o elemento que se puede usar en un tablero de escalada.
        'Por ejemplo: canto, regleta, etc.
        'Cada tipo de elemento puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Difficulty: int
        +Icon: string?
    }
    entity "BoardItemTextureMaterial" as BoardItemTextureMaterial {
        'Material de textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa un material o textura que se puede aplicar a un elemento del tablero de escalada.
        'Por ejemplo, madera, resina, goma, etc.
        'Cada material de textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItemTexture" as BoardItemTexture {
        'Textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa una textura específica que se puede aplicar a un elemento del tablero de escalada
        'Por ejemplo, liso, rugoso, áspero, etc.
        'Cada textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItem" as BoardItem {
        'Elemento del tablero, que representa una presa o elemento específico en un tablero de escalada.
        'Cada elemento puede tener diferentes propiedades y características, como posición, tipo, textura, etc
        ..inherits BaseEntity..
        +BoardConfigId: long <<unique>>
        +PositionX: int <<unique>>
        +PositionY: int <<unique>>
        +Difficulty: int
        +BoardItemTypeId: long
        +BoardItemTextureId: long?
        +BoardItemTextureMaterialId: long?
    }
}
package "Boards.Problems" {
    entity "BoardProblem" as BoardProblem {
        'Problema del tablero, que representa un conjunto de elementos (presas) organizados en un tablero de escalada.
        ..inherits BaseEntity..
        +BoardConfigId: long
        +Name: string <<unique>>
        +Description: string?
        +DifficultyScaleId: long
        +IsPublic: bool
        +CreatedByUserId: long
    }
    entity "BoardProblemItem" as BoardProblemItem {
        'Elemento del problema del tablero, que representa una presa específica en un problema de escalada.
        ..inherits BaseEntity..
        +Sequence: int?
        +BoardProblemId: long
        +BoardItemId: long
        +BoardProblemItemTypeId: long
    }
    entity "BoardProblemItemType" as BoardProblemItemType {
        'Tipo de elemento del problema del tablero, que define las características y propiedades de un elemento (presa) en un problema de escalada.
        ..inherits BaseEntity..
        +ColorRed: short
        +ColorGreen: short
        +ColorBlue: short
        +ColorName: string?
        +ColorCode: int
        +IsFoot: bool
        ' Foot: Presa que se usa como pie.
        +IsHand: bool
        ' Hand: Presa que se usa como mano.
        +IsStart: bool
        ' Start: Presa(s) que se usa como inicio del problema.
        +IsEnd: bool
        ' End: Presa(s) que se usa como final del problema.
        +IsZone: bool
        ' Zone: Presa que se puede designar como zona de descanso, pero no es obligatoria.
        +IsMandatory: bool
        'Mandatory: Presa que debe usarse, aunque el orden no importa.
        +IsTouchOnly: bool
        'TouchOnly: Solo se toca, no se debe mantener
    }
}
package "DifficultyScales" {
    entity "DifficultyScaleType" as DifficultyScaleType {
        'Tipo de escalada, por ejemplo, deportiva, boulder, trad, etc.
        'Define el tipo de escala de dificultad que se utilizará.
        'Value Object
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Icon: string?
    }
    entity "DifficultyScaleName" as DifficultyScaleName {
        'Nombre de la escala de dificultad, por ejemplo, VScale, French, etc.
        'Asocia un nombre de escala de dificultad con un tipo de escala.
        'Value Object
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +DifficultyScaleTypeId: long
    }
    entity "DifficultyScale" as DifficultyScale {
        'Escala de dificultad, por ejemplo, V1, 5.10a, etc.
        'Asocia un nombre de escala de dificultad con un grupo de dificultad.
        'Value Object
        'Representa una escala de dificultad específica dentro de un tipo y nombre de escala.
        ..inherits BaseEntity..
        +DifficultyScaleNameId: long
        +DifficultyGroupId: long
        +Value: string
        +IRCRA: int
    }
    entity "DifficultyGroup" as DifficultyGroup {
        'Grupo de dificultad, por ejemplo, principiante, intermedio, avanzado, elite, etc.
        'Agrupa escalas de dificultad bajo un mismo grupo.
        'Value Object
        ..inherits BaseEntity..
        +Level: int
        +Name: string
        +Description: string?
    }
}
