package "AI" {
    entity "AIModel" as AIModel {
        'Modelo de inteligencia artificial que se utiliza para generar problemas de escalada.
        'Puede ser una red neuronal, un modelo de lenguaje o un algoritmo genético.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Type: string
        ' Tipo del modelo: "NeuralNetwork", "GeneticAlgorithm", "LanguageModel", etc.
        +Version: string
        +Parameters: jsonb
        ' Parámetros específicos del modelo, como hiperparámetros o configuraciones.
        +IsActive: bool
    }

    entity "AIGenerationRequest" as AIGenerationRequest {
        'Solicitud para generar un problema de escalada utilizando un modelo de IA.
        ..inherits BaseEntity..
        +RequestedByUserId: long
        +AIModelId: long
        +Difficulty: int?
        ' Dificultad deseada para el problema.
        +Description: string?
        ' Descripción opcional de la ruta o características deseadas.
        +Status: string
        ' Estado de la solicitud: "Pending", "InProgress", "Completed", "Failed".
        +GeneratedBoardProblemId: long?
        ' Referencia al problema generado, si aplica.
        +ErrorMessage: string?
        ' Mensaje de error en caso de fallo.
        +CreatedAt: DateTime
        +CompletedAt: DateTime?
    }

    entity "AITrainingData" as AITrainingData {
        'Datos de entrenamiento utilizados para mejorar los modelos de IA.
        'En este caso, los datos provienen de los problemas de escalada existentes.
        ..inherits BaseEntity..
        +BoardProblemId: long
        ' Referencia al problema de escalada utilizado como dato de entrenamiento.
        +Content: jsonb
        ' Datos específicos del problema, como dificultad, descripción, y elementos.
        +UsedByModelId: long
        ' Modelo que utilizó estos datos para entrenamiento.
        +CreatedAt: DateTime
    }

    entity "AIModelLog" as AIModelLog {
        'Registro de actividades y resultados de los modelos de IA.
        ..inherits BaseEntity..
        +AIModelId: long
        +Action: string
        ' Acción realizada: "Training", "Generation", etc.
        +InputData: jsonb
        ' Datos de entrada utilizados.
        +OutputData: jsonb
        ' Datos de salida generados.
        +Duration: int
        ' Duración de la acción en milisegundos.
        +Status: string
        ' Estado de la acción: "Success", "Failure".
        +ErrorMessage: string?
        ' Mensaje de error en caso de fallo.
        +CreatedAt: DateTime
    }
}
