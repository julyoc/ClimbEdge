@startuml ClimbEdge.Docs.Diagrams.EntityRelation

entity "BaseEntity" as BaseEntity {
    +Id: long
    +Uid: Guid
    +Slug: string <<unique>>
    +Metadata: jsonb
    +RowVersion: byte[]
    +CreatedAt: DateTime
    +UpdatedAt: DateTime?
    +DeletedAt: DateTime?
    +RestoredAt: DateTime?
    +LockedAt: DateTime?
}
entity "Configuration" as Configuration {
    'Configuración del sistema, que almacena configuraciones globales y personalizadas.
    'Representa una configuración específica del sistema, como preferencias de usuario, configuraciones de aplicación
    ..inherits BaseEntity..
    +Key: string <<unique>>
    +Value: string
    +Description: string?
    +IsSensitive: bool
    +UserId: long
}
entity "UserProfile" as UserProfile {
    ..inherits BaseEntity..
    +UserId: long <<unique>>
    +FirstName: string?
    +LastName: string?
    +DateOfBirth: DateOnly?
    +Bio: string?
    +ProfilePictureUrl: string?
    +Website: string?
    +Location: string?
    +Country: string
    +TimeZone: string
    +PreferredLanguage: string
    +IsPublic: bool
    +EmailNotifications: bool
    +PushNotifications: bool
    +ClimbingExperienceLevel: string?
    +PreferredClimbingStyle: string?
    +EmergencyContact: string?
    +EmergencyContactName: string?
}
entity "AppUser" as AppUser {
    ..inherits BaseEntity..
    +Username: string? <<unique>>
    +NormalizedUserName: string? <<unique>>
    +Email: string? <<unique>>
    +NormalizedEmail: string? <<unique>>
    +EmailConfirmed: bool
    +PasswordHash: string?
    +SecurityStamp: string?
    +ConcurrencyStamp: string?
    +PhoneNumber: string?
    +PhoneNumberConfirmed: bool
    +TwoFactorEnabled: bool
    +LockoutEnd: DateTime?
    +LockoutEnabled: bool
    +AccessFailedCount: int
}
entity "AppRole" as AppRole {
    +Id: long
    +Name: string? <<unique>>
    +NormalizedName: string? <<unique>>
    +ConcurrencyStamp: string?
}
package "Boards" {
    enum "BoardVisibility" as BoardVisibility {
        +Public
        'Public: El tablero es visible para todos los usuarios.
        +Private
        'Private: El tablero es visible solo para los miembros del tablero.
        +Protected
        'Protected: El tablero es visible para los miembros del tablero y aquellos con el enlace directo.
        +Hidden
        'Hidden: El tablero no es visible en la lista de tableros, pero accesible mediante enlace directo.
        +Archived
        'Archived: El tablero está archivado y no es visible, pero se puede restaurar.
    }
    enum "BoardMemberRole" as BoardMemberRole {
        +Owner 
        'Owner: Propietario del tablero, tiene todos los permisos.
        +Admin
        'Admin: Administrador del tablero, puede gestionar miembros y configuraciones.
        +Member
        'Member: Miembro del tablero, puede ver y participar en el tablero.
        +Viewer
        'Viewer: Solo puede ver el tablero, sin permisos de edición.
    }
    entity "Board" as Board {
        'Tablero de escalada, que puede contener problemas, configuraciones y miembros.
        'Representa un espacio de trabajo para organizar y gestionar problemas de escalada.
        'Por ejemplo un moon board, un muro de escalada o una zona de escalada.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Visibility: BoardVisibility
        +BoardConfigId: long
        ' Configuración del tablero, que define las propiedades y características del tablero.
    }
    entity "BoardMember" as BoardMember {
        'Miembro del tablero, que puede tener diferentes roles y permisos.
        'Representa a un usuario que forma parte de un tablero de escalada.
        ..inherits BaseEntity..
        +BoardId: long
        +UserId: long
        +IsPropertyOwner: bool
        +Role: BoardMemberRole
    }
    entity "BoardConfig" as BoardConfig {
        'Configuración del tablero, que define las propiedades y características del tablero.
        ..inherits BaseEntity..
        +Content: string
        +Columns: int
        +Rows: int
        +Width: int
        +Height: int
        +InterItemSpacingVertical: int
        +InterItemSpacingHorizontal: int
        ' Espacio entre elementos del tablero, que define la separación media entre las presas.
        +IsStaggeredGrid: bool
        ' StaggeredGrid: Indica si el tablero utiliza un diseño de cuadrícula escalonada.
        '   true: El tablero utiliza un diseño de cuadrícula escalonada.
        '   false: El tablero utiliza un diseño de cuadrícula regular.
        +StaggeredGridOffset: int
        ' StaggeredGridOffset: Desplazamiento de la cuadrícula escalonada
        +Difficulty: int
    }
    entity "BoardAngle" as BoardAngle {
        'Ángulo de inclinación del tablero, que define la inclinación del tablero de escalada.
        'Representa un ángulo específico de inclinación del tablero, como vertical, 20 grados, etc.
        'El rango del ángulo puede variar según el tipo de tablero. Normal de 10 a 65 grados.
        'Cada ángulo puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Angle: int <<unique>>
        +Unit: string
        ' Unidad del ángulo, por ejemplo, grados, radianes, etc.
        +Description: string?
    }
    entity "BoardItemType" as BoardItemType {
        'Tipo de elemento del tablero, que define las características y propiedades de un elemento (presa).
        'Representa un tipo de presa o elemento que se puede usar en un tablero de escalada.
        'Por ejemplo: canto, regleta, etc.
        'Cada tipo de elemento puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +Difficulty: int
        +Icon: string?
    }
    entity "BoardItemTextureMaterial" as BoardItemTextureMaterial {
        'Material de textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa un material o textura que se puede aplicar a un elemento del tablero de escalada.
        'Por ejemplo, madera, resina, goma, etc.
        'Cada material de textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItemTexture" as BoardItemTexture {
        'Textura del elemento del tablero, que define las características y propiedades de la textura de una presa.
        'Representa una textura específica que se puede aplicar a un elemento del tablero de escalada
        'Por ejemplo, liso, rugoso, áspero, etc.
        'Cada textura puede tener diferentes propiedades y características.
        ..inherits BaseEntity..
        +Name: string
        +Description: string?
        +ImageUrl: string
        +ThumbnailUrl: string?
        +Difficulty: int
        +Properties: jsonb
    }
    entity "BoardItem" as BoardItem {
        'Elemento del tablero, que representa una presa o elemento específico en un tablero de escalada.
        'Cada elemento puede tener diferentes propiedades y características, como posición, tipo, textura, etc
        ..inherits BaseEntity..
        +BoardConfigId: long
        +PositionX: int
        +PositionY: int
        'unique(BoardConfigId, PositionX, PositionY)
        +Difficulty: int
        +BoardItemTypeId: long
        +BoardItemTextureId: long?
        +BoardItemTextureMaterialId: long?
    }
}
package "Boards.Problems" {
    entity "BoardProblemAngle" as BoardProblemAngle {
        'Ángulo del problema del tablero, que define la inclinación del problema de escalada.
        +BoardProblemId: long
        +BoardAngleId: long
        'unique(BoardProblemId, BoardAngleId)
        +DifficultyScaleId: long
        +Rating: float?
    }
    entity "BoardProblemTag" {
        +Id: long
        +Name: string
        +Description: string?
    }
    entity "BoardProblem" as BoardProblem {
        'Problema del tablero, que representa un conjunto de elementos (presas) organizados en un tablero de escalada.
        ..inherits BaseEntity..
        +BoardConfigId: long
        +Name: string <<unique>>
        +Description: string?
        +IsPublic: bool
        +CreatedByUserId: long? <<index>>
    }
    entity "BoardProblemItem" as BoardProblemItem {
        'Elemento del problema del tablero, que representa una presa específica en un problema de escalada.
        ..inherits BaseEntity..
        +Sequence: int?
        +BoardProblemId: long
        +BoardItemId: long
        +BoardProblemItemTypeId: long
    }
    entity "BoardProblemItemType" as BoardProblemItemType {
        'Tipo de elemento del problema del tablero, que define las características y propiedades de un elemento (presa) en un problema de escalada.
        ..inherits BaseEntity..
        +ColorRed: short
        +ColorGreen: short
        +ColorBlue: short
        +ColorName: string?
        +ColorCode: int
        +IsFoot: bool
        ' Foot: Presa que se usa como pie.
        +IsHand: bool
        ' Hand: Presa que se usa como mano.
        +IsStart: bool
        ' Start: Presa(s) que se usa como inicio del problema.
        +IsEnd: bool
        ' End: Presa(s) que se usa como final del problema.
        +IsZone: bool
        ' Zone: Presa que se puede designar como zona de descanso, pero no es obligatoria.
        +IsMandatory: bool
        'Mandatory: Presa que debe usarse, aunque el orden no importa.
        +IsTouchOnly: bool
        'TouchOnly: Solo se toca, no se debe mantener
        +Difficulty: int
        ' Dificultad del elemento, que debe ser un valor numérico.
    }
    entity "FootRule" as FootRule {
        ..inherits BaseEntity..
        'Regla de uso de pies en el problema de escalada.
        +Name: string
        +Code: string
        +Description: string
    }
}
package "DifficultyScales" {
    entity "DifficultyScaleType" as DifficultyScaleType {
        'Tipo de escalada, por ejemplo, deportiva, boulder, trad, etc.
        'Define el tipo de escala de dificultad que se utilizará.
        'Value Object
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Icon: string?
    }
    entity "DifficultyScaleName" as DifficultyScaleName {
        'Nombre de la escala de dificultad, por ejemplo, VScale, French, etc.
        'Asocia un nombre de escala de dificultad con un tipo de escala.
        'Value Object
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +DifficultyScaleTypeId: long
    }
    entity "DifficultyScale" as DifficultyScale {
        'Escala de dificultad, por ejemplo, V1, 5.10a, etc.
        'Asocia un nombre de escala de dificultad con un grupo de dificultad.
        'Value Object
        'Representa una escala de dificultad específica dentro de un tipo y nombre de escala.
        ..inherits BaseEntity..
        +DifficultyScaleNameId: long
        +DifficultyGroupId: long
        +Value: string
        +IRCRA: int
    }
    entity "DifficultyGroup" as DifficultyGroup {
        'Grupo de dificultad, por ejemplo, principiante, intermedio, avanzado, elite, etc.
        'Agrupa escalas de dificultad bajo un mismo grupo.
        'Value Object
        ..inherits BaseEntity..
        +Level: int
        +Name: string
        +Description: string?
        +IsFemale: bool
        ' IsFemale: Indica si el grupo de dificultad es específico para escaladoras mujeres.
    }
}
package "Mountains" {
    enum "MountainType" as MountainType {
        +Peak
        'Peak: Pico o cumbre montañosa.
        +Ridge
        'Ridge: Cordillera o cresta.
        +Volcano
        'Volcano: Volcán.
        +Hill
        'Hill: Colina.
        +Plateau
        'Plateau: Meseta.
        +Canyon
        'Canyon: Cañón.
        +Valley
        'Valley: Valle.
    }
    enum "RouteType" as RouteType {
        +Hiking
        'Hiking: Senderismo.
        +Mountaineering
        'Mountaineering: Montañismo.
        +RockClimbing
        'RockClimbing: Escalada en roca.
        +IceClimbing
        'IceClimbing: Escalada en hielo.
        +MixedClimbing
        'MixedClimbing: Escalada mixta.
        +Skiing
        'Skiing: Esquí.
        +Snowboarding
        'Snowboarding: Snowboard.
        +Via_Ferrata
        'Via_Ferrata: Vía ferrata.
    }
    enum "SeasonType" as SeasonType {
        +Spring
        'Spring: Primavera.
        +Summer
        'Summer: Verano.
        +Autumn
        'Autumn: Otoño.
        +Winter
        'Winter: Invierno.
        +YearRound
        'YearRound: Todo el año.
    }
    entity "Mountain" as Mountain {
        'Montaña o formación geológica específica.
        ..inherits BaseEntity..
        +Name: string <<unique>>
        +Description: string?
        +Type: MountainType
        +Elevation: int
        ' Elevación en metros sobre el nivel del mar.
        +Location: geography(POINT,4326)
        ' Coordenadas geográficas usando PostGIS (latitud, longitud).
        +Country: string
        +Region: string?
        +Province: string?
        +FirstAscentDate: DateTime?
        +FirstAscentBy: string?
        ' Nombre de quien realizó la primera ascensión.
        +IsActive: bool
        ' Indica si la montaña está disponible para actividades.
        +DangerLevel: int
        ' Nivel de peligro del 1 al 5.
        +ImageUrl: string?
        +WeatherStationId: string?
        ' ID de estación meteorológica cercana.
    }
    entity "MountainRoute" as MountainRoute {
        'Ruta específica en una montaña.
        ..inherits BaseEntity..
        +MountainId: long
        +Name: string
        +Description: string?
        +Type: RouteType
        +DifficultyScaleId: long
        +Distance: decimal
        ' Distancia total de la ruta en kilómetros.
        +ElevationGain: int
        ' Ganancia de elevación en metros.
        +EstimatedDuration: int
        ' Duración estimada en minutos.
        +BestSeason: SeasonType
        +RequiresPermit: bool
        +MaxGroupSize: int?
        +IsGuided: bool
        ' Indica si requiere guía obligatorio.
        +DangerLevel: int
        ' Nivel de peligro específico de la ruta.
        +FirstAscentDate: DateTime?
        +FirstAscentBy: string?
    }
    entity "RouteWaypoint" as RouteWaypoint {
        'Puntos de referencia a lo largo de una ruta.
        ..inherits BaseEntity..
        +MountainRouteId: long
        +Name: string
        +Description: string?
        +Location: geography(POINT,4326)
        ' Coordenadas del waypoint usando PostGIS.
        +Elevation: int
        ' Elevación del punto en metros.
        +Sequence: int
        ' Orden en la secuencia de la ruta.
        +WaypointType: string
        ' Tipo: "Start", "Summit", "Camp", "Water", "Danger", "Rest", "Junction", "End".
        +EstimatedTimeFromPrevious: int?
        ' Tiempo estimado desde el waypoint anterior en minutos.
        +Notes: string?
        +ImageUrl: string?
    }
    entity "RouteTrack" as RouteTrack {
        'Track GPS completo de la ruta.
        ..inherits BaseEntity..
        +MountainRouteId: long
        +Name: string?
        +TrackData: geography(LINESTRING,4326)
        ' Línea GPS completa usando PostGIS.
        +TotalDistance: decimal
        ' Distancia total calculada del track.
        +MinElevation: int
        +MaxElevation: int
        +RecordedBy: string?
        ' Quien registró el track.
        +RecordedDate: DateTime?
        +GpsDevice: string?
        ' Dispositivo GPS utilizado.
        +Accuracy: decimal?
        ' Precisión del GPS en metros.
    }
    entity "MountainFile" as MountainFile {
        'Archivos asociados a montañas (fotos, mapas, documentos).
        ..inherits BaseEntity..
        +MountainId: long
        +FileType: string
        ' Tipo: "Photo", "Map", "Topo", "Document", "Video", "3DModel".
        +FileName: string
        +FileSize: int
        +FileUrl: string
        +ThumbnailUrl: string?
        +Title: string?
        +Description: string?
        +TakenAt: DateTime?
        ' Fecha en que se tomó la foto/video.
        +TakenBy: string?
        ' Quien tomó la foto/video.
        +Location: geography(POINT,4326)?
        ' Ubicación donde se tomó la foto.
        +Elevation: int?
        +IsPublic: bool
    }
    entity "RouteFile" as RouteFile {
        'Archivos específicos de rutas (croquis, fotos, GPX).
        ..inherits BaseEntity..
        +MountainRouteId: long
        +FileType: string
        ' Tipo: "Topo", "Photo", "GPX", "KML", "Croquis", "Document".
        +FileName: string
        +FileSize: int
        +FileUrl: string
        +ThumbnailUrl: string?
        +Title: string?
        +Description: string?
        +IsOfficial: bool
        ' Indica si es un archivo oficial de la ruta.
        +UploadedBy: long?
        ' Usuario que subió el archivo.
    }
    entity "WeatherCondition" as WeatherCondition {
        'Condiciones meteorológicas históricas y actuales.
        ..inherits BaseEntity..
        +MountainId: long
        +RecordedAt: DateTime
        +Temperature: decimal?
        ' Temperatura en grados Celsius.
        +WindSpeed: decimal?
        ' Velocidad del viento en km/h.
        +WindDirection: int?
        ' Dirección del viento en grados.
        +Humidity: decimal?
        ' Humedad relativa en porcentaje.
        +Pressure: decimal?
        ' Presión atmosférica en hPa.
        +Visibility: decimal?
        ' Visibilidad en kilómetros.
        +WeatherCondition: string?
        ' Descripción: "Clear", "Cloudy", "Rain", "Snow", "Storm", etc.
        +SnowDepth: decimal?
        ' Profundidad de nieve en centímetros.
        +DataSource: string?
        ' Fuente de datos: "Manual", "WeatherAPI", "Station", etc.
    }
}
package "Mountains.Itinerary" {
    enum MountaineerTickType {
        'Summit: Cima alcanzada exitosamente.
        Summit
        'Attempted: Intentado, pero no se alcanzó la cumbre (retirada por clima, fatiga, etc.).
        Attempted
        'Planned: Ascenso planificado, aún no intentado.
        Planned
        'Abandoned: Expedición abandonada antes o durante el intento.
        Abandoned
        'Failed: Intento fallido por causas externas o físicas (no cima, no éxito, más grave).
        Failed
        'Rescue: Se necesitó rescate o evacuación.
        Rescue
        'Repeat: Cima ya alcanzada previamente, ruta repetida.
        Repeat
    }
    enum "ExpeditionStatus" as ExpeditionStatus {
        +Planning
        'Planning: En planificación.
        +Scheduled
        'Scheduled: Programada.
        +InProgress
        'InProgress: En curso.
        +Completed
        'Completed: Completada.
        +Cancelled
        'Cancelled: Cancelada.
        +Postponed
        'Postponed: Pospuesta.
        +Emergency
        'Emergency: Situación de emergencia.
    }
    enum "ParticipantRole" as ParticipantRole {
        +Guide
        'Guide: Guía certificado.
        +Leader
        'Leader: Líder de expedición.
        +Participant
        'Participant: Participante.
        +Assistant
        'Assistant: Asistente.
        +Medic
        'Medic: Médico.
        +Cook
        'Cook: Cocinero.
        +Porter
        'Porter: Porteador.
    }
    enum "DayActivityType" as DayActivityType {
        +Ascent
        'Ascent: Ascenso.
        +Descent
        'Descent: Descenso.
        +Rest
        'Rest: Descanso.
        +Acclimatization
        'Acclimatization: Aclimatación.
        +Travel
        'Travel: Viaje/Aproximación.
        +Setup
        'Setup: Montaje de campamento.
        +Recovery
        'Recovery: Recuperación.
        +Weather_Wait
        'Weather_Wait: Espera por clima.
    }
    entity "Expedition" as Expedition {
        'Expedición completa a una montaña con itinerario detallado.
        ..inherits BaseEntity..
        +MountainId: long
        +MountainRouteId: long?
        +Name: string
        +Description: string?
        +Status: ExpeditionStatus
        +StartDate: DateTime
        +EndDate: DateTime
        +PlannedDuration: int
        ' Duración planificada en días.
        +ActualDuration: int?
        ' Duración real en días.
        +MaxParticipants: int
        +MinParticipants: int
        +RequiredExperienceLevel: string?
        +Cost: decimal?
        +Currency: string?
        +RequiresPermit: bool
        +PermitNumber: string?
        +InsuranceRequired: bool
        +EmergencyContactInfo: string?
        +BaseLocation: string?
        ' Ubicación del campamento base.
        +OrganizedBy: long
        ' Usuario organizador.
        +IsPublic: bool
        +RegistrationDeadline: DateTime?
    }
    entity "ExpeditionParticipant" as ExpeditionParticipant {
        'Participantes de la expedición.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +UserId: long
        +Role: ParticipantRole
        +JoinedAt: DateTime
        +Status: string
        ' Estado: "Registered", "Confirmed", "Cancelled", "Completed".
        +ExperienceLevel: string?
        +MedicalClearance: bool
        +EmergencyContact: string?
        +SpecialRequirements: string?
        +PaymentStatus: string?
        ' Estado del pago: "Pending", "Paid", "Refunded".
        +Notes: string?
    }
    entity "ItineraryDay" as ItineraryDay {
        'Día específico del itinerario.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +DayNumber: int
        +Date: DateTime
        +ActivityType: DayActivityType
        +Title: string
        +Description: string?
        +StartLocation: string?
        +EndLocation: string?
        +StartElevation: int?
        +EndElevation: int?
        +Distance: decimal?
        ' Distancia en kilómetros.
        +ElevationGain: int?
        +ElevationLoss: int?
        +EstimatedDuration: int?
        ' Duración estimada en minutos.
        +DifficultyLevel: int?
        ' Nivel de dificultad del 1 al 5.
        +WeatherDependency: bool
        +IsRestDay: bool
        +Notes: string?
    }
    entity "DayActivity" as DayActivity {
        'Actividades específicas dentro de un día.
        ..inherits BaseEntity..
        +ItineraryDayId: long
        +Sequence: int
        +StartTime: time?
        +EndTime: time?
        +ActivityName: string
        +Description: string?
        +Location: geography(POINT,4326)?
        +Elevation: int?
        +EstimatedDuration: int?
        +IsOptional: bool
        +RequiredEquipment: string?
        +SafetyNotes: string?
        +AlternativePlan: string?
        ' Plan alternativo en caso de problemas.
    }
    entity "Equipment" as Equipment {
        'Equipamiento necesario para la expedición.
        ..inherits BaseEntity..
        +Name: string
        +Category: string
        ' Categoría: "Climbing", "Camping", "Safety", "Clothing", "Navigation", etc.
        +Description: string?
        +IsPersonal: bool
        ' Indica si es equipo personal o grupal.
        +IsMandatory: bool
        +Weight: decimal?
        ' Peso en kilogramos.
        +Brand: string?
        +Model: string?
        +Specifications: string?
        +ImageUrl: string?
    }
    entity "ExpeditionEquipment" as ExpeditionEquipment {
        'Equipamiento requerido para una expedición específica.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +EquipmentId: long
        +Quantity: int
        +IsMandatory: bool
        +IsProvided: bool
        ' Indica si el equipo es proporcionado por la organización.
        +ResponsibleParticipant: long?
        ' Participante responsable del equipo.
        +Notes: string?
    }
    entity "ExpeditionBudget" as ExpeditionBudget {
        'Presupuesto detallado de la expedición.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +Category: string
        ' Categoría: "Transport", "Accommodation", "Food", "Equipment", "Permits", "Insurance", "Guide", "Emergency".
        +Description: string
        +PlannedCost: decimal
        +ActualCost: decimal?
        +Currency: string
        +IsPaid: bool
        +PaymentDate: DateTime?
        +Vendor: string?
        +Notes: string?
    }
    entity "SafetyPlan" as SafetyPlan {
        'Plan de seguridad de la expedición.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +EmergencyContactName: string
        +EmergencyContactPhone: string
        +EmergencyContactRelation: string
        +LocalRescueService: string?
        +NearestHospital: string?
        +EvacuationPlan: string?
        +CommunicationPlan: string?
        ' Plan de comunicación y horarios de contacto.
        +RiskAssessment: string?
        +ContingencyPlans: string?
        +MedicalSupplies: string?
        +LastUpdated: DateTime
    }
    entity "ItineraryFile" as ItineraryFile {
        'Archivos relacionados con el itinerario.
        ..inherits BaseEntity..
        +ExpeditionId: long
        +FileType: string
        ' Tipo: "Itinerary", "Map", "PermitDoc", "Insurance", "MedicalForm", "Agreement".
        +FileName: string
